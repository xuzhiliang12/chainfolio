# Local installations do not require environment variables.
# The first browser visit creates the local owner account and Chainfolio
# generates its own session secret inside the private data directory.

# Optional overrides for advanced/server deployments:
# SESSION_SECRET=replace-with-at-least-32-random-characters
# COOKIE_SECURE=true
# ETHEREUM_RPC_URL=https://your-trusted-rpc.example
# BNB_RPC_URL=https://your-trusted-rpc.example
# Optional indexed token discovery. When set, Etherscan's address-token API is
# tried before the public RPC log fallback. Keep the key on the server only.
# ETHERSCAN_API_KEY=replace-with-your-etherscan-api-key
# ETHERSCAN_API_BASE=https://api.etherscan.io/v2/api
# *_BLOCKSCOUT_API can point to a self-hosted Blockscout API v2 base when
# the public instance is unavailable (for example, https://eth.blockscout.com/api/v2).
# ETHEREUM_BLOCKSCOUT_API=https://eth.blockscout.com/api/v2
# ARBITRUM_BLOCKSCOUT_API=https://arbitrum.blockscout.com/api/v2
# BASE_BLOCKSCOUT_API=https://base.blockscout.com/api/v2
# OPTIMISM_BLOCKSCOUT_API=https://optimism.blockscout.com/api/v2
# ROBINHOOD_BLOCKSCOUT_API=https://robinhoodchain.blockscout.com/api/v2
# Optional trusted RPC overrides. A dedicated RPC with historical log support
# is more reliable than a rate-limited public RPC for large address sets.
# BNB_RPC_URL=https://your-trusted-rpc.example
# XLAYER_RPC_URL=https://your-trusted-rpc.example
# TOKEN_DISCOVERY_MAX_TOKENS=250
# TOKEN_DISCOVERY_MAX_LOGS=20000
# TOKEN_DISCOVERY_FULL_HISTORY=false
