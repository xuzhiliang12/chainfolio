# Local installations do not require environment variables.
# The first browser visit creates the local owner account and Chainfolio
# generates its own session secret inside the private data directory.

# Optional overrides for advanced/server deployments:
# SESSION_SECRET=replace-with-at-least-32-random-characters
# COOKIE_SECURE=true
# ETHEREUM_RPC_URL=https://your-trusted-rpc.example
# BNB_RPC_URL=https://your-trusted-rpc.example
